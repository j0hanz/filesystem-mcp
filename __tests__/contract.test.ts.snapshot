exports[`Advertised MCP contract > CONTRACT-001: full server surface matches the snapshot 1`] = `
{
  "capabilities": {
    "completions": {},
    "prompts": {
      "listChanged": true
    },
    "resources": {
      "subscribe": true,
      "listChanged": true
    },
    "tools": {
      "listChanged": true
    }
  },
  "instructions": "Navigation guide for filesystem-mcp tools and constraints. Use list_roots to inspect configured or accepted roots, then list/find_files -> stat -> read. Never guess paths. For full guidance, read internal://instructions or run the get-help prompt.",
  "tools": [
    {
      "name": "create",
      "title": "Create Files",
      "description": "Write whole text files (create, overwrite, or append) or make empty directories. Use when creating new files, replacing full contents, or creating folders. Missing parent directories are created automatically. Replacing an existing file requires overwrite: true or user confirmation. Returns created paths and an undo id. Use edit or patch to modify parts of an existing file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "description": "List of files to create (max 100); each entry requires path and content; combined content is capped at the file-size limit",
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "Absolute path where the file will be created"
                },
                "content": {
                  "type": "string",
                  "description": "Text content to write, verbatim."
                },
                "append": {
                  "description": "Append the content verbatim, adding no newline; creates the file if it does not exist",
                  "type": "boolean"
                },
                "overwrite": {
                  "description": "Replace an existing file without asking the user; without it an existing file prompts for confirmation. A client that cannot show a prompt fails with INVALID_INPUT and a workaround instead.",
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "directories": {
            "description": "Empty directories to create, like mkdir -p; one that already exists is left as it is",
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "File or directory path inside an allowed workspace root."
            }
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "delete",
      "title": "Delete File",
      "description": "Delete files, directories, or symlinks, like rm or rm -r. Use when permanently removing paths. Paths are exact (globs are not expanded). Non-empty directories require recursive: true and confirmation. Set ignoreIfNotExists: true to succeed cleanly if a path is already absent. Returns { path, deleted } per path and an undo id. Use move to relocate a path instead.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "paths": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "File or directory path inside an allowed workspace root."
            },
            "description": "Paths to delete (max 1000); accepts files, directories, or symlinks"
          },
          "recursive": {
            "default": false,
            "description": "Delete directory contents recursively (required for non-empty directories). A recursive delete of a non-empty directory asks the user to confirm; a client that cannot show a prompt fails with INVALID_INPUT and nothing in the call is deleted.",
            "type": "boolean"
          },
          "ignoreIfNotExists": {
            "default": false,
            "description": "Silently succeed if a path does not exist instead of returning an error",
            "type": "boolean"
          }
        },
        "required": [
          "paths"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "diff",
      "title": "Diff",
      "description": "Compare two text files and return a unified diff from a to b, like diff -u. Use when reviewing changes between two files. Returns the unified diff with linesAdded and linesRemoved in metadata; identical files return no hunks. Rejects binary and non-UTF-8 files; files too different give TOO_LARGE. Use read to inspect full files or slices first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "First file to compare"
          },
          "b": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Second file to compare"
          },
          "context": {
            "default": 3,
            "description": "Number of context lines surrounding each change (default: 3)",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 50
          }
        },
        "required": [
          "a",
          "b"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "edit",
      "title": "Edit Files",
      "description": "Edit text files in place by replacing exact oldText with newText. Use when changing specific unique snippets in one or more files. Each oldText must match exactly once; unmatched or ambiguous text fails and leaves the file untouched. Returns an edit summary with added and removed line counts, plus an undo id; dryRun previews the unified diff. Use replace_text for multiple occurrences or regex, patch to apply unified diffs, and create for new files.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Single file path; mutually exclusive with files",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "edits": {
            "description": "Replacements applied to path (required with path); not allowed with files",
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "oldText": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1048576,
                  "description": "Exact literal text to locate in the file; it must match exactly once. Include 3-5 lines of context so it does — an oldText found in several places fails with their line numbers.",
                  "examples": [
                    "const x = 1;",
                    "function oldName("
                  ]
                },
                "newText": {
                  "type": "string",
                  "description": "Replacement text. Use an empty string to delete the matched oldText.",
                  "examples": [
                    "const x = 2;",
                    "function newName(",
                    ""
                  ]
                }
              },
              "required": [
                "oldText",
                "newText"
              ],
              "additionalProperties": false
            }
          },
          "files": {
            "description": "Per-file entries (batch mode)",
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "File or directory path inside an allowed workspace root."
                },
                "edits": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "oldText": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1048576,
                        "description": "Exact literal text to locate in the file; it must match exactly once. Include 3-5 lines of context so it does — an oldText found in several places fails with their line numbers.",
                        "examples": [
                          "const x = 1;",
                          "function oldName("
                        ]
                      },
                      "newText": {
                        "type": "string",
                        "description": "Replacement text. Use an empty string to delete the matched oldText.",
                        "examples": [
                          "const x = 2;",
                          "function newName(",
                          ""
                        ]
                      }
                    },
                    "required": [
                      "oldText",
                      "newText"
                    ],
                    "additionalProperties": false
                  },
                  "description": "Replacements to apply to this specific file"
                }
              },
              "required": [
                "path",
                "edits"
              ],
              "additionalProperties": false
            }
          },
          "dryRun": {
            "default": false,
            "description": "Preview diffs without writing to disk (default: false = apply edits)",
            "type": "boolean"
          },
          "ignoreWhitespace": {
            "default": false,
            "description": "Ignore leading/trailing whitespace differences when matching oldText; newText is re-indented to the match and replaces its inner blank lines",
            "type": "boolean"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list",
      "title": "List",
      "description": "List directory contents as a tree of names, like ls or tree. Use when exploring directory structure or checking folder contents. Traversal is one level deep unless maxDepth is raised. Skips hidden and ignored files (.git, node_modules) by default. sortBy: size orders largest first. Returns formatted tree text with nextCursor when paged. Use find_files to find files by name, stat for metadata, and read for contents.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Directory to list (default: the only root)",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxDepth": {
            "default": 1,
            "description": "Max directory depth to traverse (default: 1 = top-level only; increase to recurse deeper)",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 50
          },
          "maxEntries": {
            "default": 1000,
            "description": "Page size (default: 1000). Continue with nextCursor; an incomplete first page also carries resourceUri for the whole list.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 20000
          },
          "includeHidden": {
            "default": false,
            "description": "Include hidden items (starting with .)",
            "type": "boolean"
          },
          "includeIgnored": {
            "default": false,
            "description": "Include ignored items (node_modules, .git, etc).",
            "type": "boolean"
          },
          "includeSizes": {
            "default": false,
            "description": "Show file sizes in the tree and a totals line of counts and bytes",
            "type": "boolean"
          },
          "sortBy": {
            "default": "name",
            "description": "Order within each directory: name (default) or size (largest first)",
            "type": "string",
            "enum": [
              "name",
              "size"
            ]
          },
          "cursor": {
            "description": "Opaque pagination cursor; pass unchanged for the next page. Pages slice one snapshot taken on the first call; it expires after ~60s — re-request without a cursor if rejected.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "move",
      "title": "Move or Copy Files",
      "description": "Move, rename, or copy files and directories, like mv or cp -r. Use when renaming paths, moving files between directories, or copying trees (copy: true). Each destination must be the full target path, not an existing directory to move into. Overwrite applies only to copies; moving onto an existing file requires confirmation. Returns moved paths and an undo id. Use delete to remove paths.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "moves": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "Path of the file or directory to move or copy"
                },
                "destination": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "Destination path"
                }
              },
              "required": [
                "source",
                "destination"
              ],
              "additionalProperties": false
            },
            "description": "Operations to perform (max 100)"
          },
          "copy": {
            "default": false,
            "description": "Copy instead of move; sources are left in place",
            "type": "boolean"
          },
          "overwrite": {
            "default": false,
            "description": "Copy mode only: overwrite existing destinations without confirmation",
            "type": "boolean"
          }
        },
        "required": [
          "moves"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "patch",
      "title": "Patch",
      "description": "Apply a single-file unified diff to an existing text file, like git apply. Use when applying diffs produced by diff tools or git. Writes nothing unless every hunk applies in order with exact context; mismatched hunks fail and leave the file untouched. Returns lines added and removed, plus an undo id. Use dryRun to test applicability cleanly. Use edit for unique snippet replacements, and replace_text for regex across files.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "File to apply the diff to"
          },
          "diff": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576,
            "description": "Single-file unified diff to apply (as produced by the diff tool or edit dry-run)"
          },
          "dryRun": {
            "default": false,
            "description": "Preview the diff without writing (default: false)",
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "diff"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "read",
      "title": "Read File",
      "description": "Read text files, like cat: whole file or a slice via head, tail, or 1-based startLine/endLine. Use when inspecting file contents. Pass binary: true to read binary files as base64 resources (slicing disabled). Images and audio return as media. Returns file text or slice, or per-path results for batches. Use stat for size and token estimates before reading, search_text to find text, and list to browse folders.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "includeHash": {
            "default": false,
            "description": "Include SHA-256 of the returned content (the slice for head, tail or a line range)",
            "type": "boolean"
          },
          "binary": {
            "default": false,
            "description": "Return a binary file that is not an image or audio whole, as a base64 embedded resource. Full reads only.",
            "type": "boolean"
          },
          "lineNumbers": {
            "default": false,
            "description": "Prefix each line with its number and a tab, like cat -n. Not with tail. Leave the prefix out of edit text.",
            "type": "boolean"
          },
          "head": {
            "description": "Return first N lines",
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "tail": {
            "description": "Return last N lines",
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "startLine": {
            "description": "Start line (1-indexed)",
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "endLine": {
            "description": "End line (1-indexed); requires startLine",
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "path": {
            "description": "Single file path; mutually exclusive with paths",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "paths": {
            "description": "Array of file paths for batch mode (max 1000); mutually exclusive with path",
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "File or directory path inside an allowed workspace root."
            }
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "anthropic/maxResultSizeChars": 200000
      }
    },
    {
      "name": "replace_text",
      "title": "Search and Replace",
      "description": "Find and replace text or an RE2 regex across one file or all files under a directory in place, like sed -i. Use when replacing every match across a file or project. Patterns match whole files and can span lines (^ and $ anchor to file start and end); isRegex: true enables $1 capture replacements. Directory runs rewrite files as they scan; hitting maxMatches (default: 100) stops early and leaves reached files modified. Changes require undo to revert. Returns structured results with totalMatches, filesScanned, changed paths, and an undo id; pair dryRun: true with returnDiff: true to preview diffs cleanly. Use edit for a single unique snippet, and patch to apply unified diffs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "File to rewrite, or directory to rewrite under. Omitting it targets the ENTIRE root when there is only one; scope it deliberately, and pair a wide scope with dryRun=true first",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "pattern": {
            "description": "Glob to restrict replacements to specific file types (e.g. **/*.ts); default: all text files",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "examples": [
              "**/*.ts",
              "src/**/*.js",
              "**/*.{ts,tsx}"
            ]
          },
          "searchPattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Exact literal text or RE2 regex pattern to search for. Patterns can span lines. When isRegex=true, uses RE2 syntax (no lookahead, lookbehind, or backreferences are supported). Cannot be empty or whitespace-only."
          },
          "replacement": {
            "type": "string",
            "maxLength": 10000,
            "description": "Replacement text. Use capture group references ($1, $2, etc.) when isRegex=true. Use an empty string to delete all matches.",
            "examples": [
              "$1_renamed",
              "",
              "TODO: fix"
            ]
          },
          "isRegex": {
            "default": false,
            "description": "Treat searchPattern as a RE2 regex (default: literal text match)",
            "type": "boolean"
          },
          "includeHidden": {
            "default": false,
            "description": "Include hidden items (starting with .)",
            "type": "boolean"
          },
          "includeIgnored": {
            "default": false,
            "description": "Include ignored items (node_modules, .git, etc).",
            "type": "boolean"
          },
          "caseSensitive": {
            "default": true,
            "description": "Match case exactly (default: true). Pass false to ignore case. search_text ignores case by default, so matches it reports can include case variants this call does not replace.",
            "type": "boolean"
          },
          "wholeWord": {
            "default": false,
            "description": "Match whole words only (word boundary anchoring)",
            "type": "boolean"
          },
          "dryRun": {
            "default": false,
            "description": "Preview replacements without writing to disk (default: false = apply changes). Pair with returnDiff=true to inspect proposed unified diffs before modifying files.",
            "type": "boolean"
          },
          "returnDiff": {
            "default": false,
            "description": "Include a unified diff of all changes in the response",
            "type": "boolean"
          },
          "maxMatches": {
            "description": "Maximum total match count across all files before stopping (default: 100). Reaching it stops the scan early; files rewritten before the limit remain changed on disk.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "maxFiles": {
            "description": "Maximum number of files to process",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "maxDepth": {
            "description": "Max directory depth to scan; 0 = base directory only, omit for unlimited",
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "searchPattern",
          "replacement"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_roots",
      "title": "Workspace Roots",
      "description": "List the workspace directory roots this server can access, including session-granted roots. Use when starting a session or checking accessible directory boundaries. Returns { roots, readOnlyDirs } as absolute paths. Mutating operations under readOnlyDirs are refused with ACCESS_DENIED. Other tools prompt for approval when accessing paths outside these roots.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "search_text",
      "title": "Search Content",
      "description": "Search file contents for text or an RE2 regex, like grep. Use when searching for keywords or patterns across files. searchPattern matches line by line (case-insensitive by default); pattern filters files by glob (e.g. **/*.ts). Returns matching lines with line numbers grouped by file, plus a nextCursor for paging. Use read to view full context, and find_files to find by name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "File to search, or directory to search under (default: the only root). Naming a file searches that file alone: pattern is ignored and hidden/ignored filtering does not apply.",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "pattern": {
            "description": "Glob to restrict search to specific file types (e.g. **/*.ts); default: all text files",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "examples": [
              "**/*.ts",
              "src/**/*.js",
              "**/*.{ts,tsx}"
            ]
          },
          "searchPattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Exact literal text or RE2 regex pattern to search for in file contents. When isRegex=true, uses RE2 syntax (no lookahead, lookbehind, or backreferences). Cannot be empty or whitespace-only."
          },
          "isRegex": {
            "default": false,
            "description": "Treat searchPattern as a regex (default: literal text match)",
            "type": "boolean"
          },
          "includeHidden": {
            "default": false,
            "description": "Include hidden items (starting with .)",
            "type": "boolean"
          },
          "includeIgnored": {
            "default": false,
            "description": "Include ignored items (node_modules, .git, etc).",
            "type": "boolean"
          },
          "caseSensitive": {
            "default": false,
            "description": "Enable case-sensitive matching (default: case-insensitive). Replacements match case by default, so matches found here can go unreplaced there.",
            "type": "boolean"
          },
          "maxResults": {
            "default": 500,
            "description": "Maximum number of matching lines to return per page",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "context": {
            "default": 0,
            "description": "Lines of context to return either side of each match, like grep -C (default: 0, max: 10)",
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "maxDepth": {
            "description": "Max directory depth to scan; 0 = base directory only, omit for unlimited",
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "cursor": {
            "description": "Opaque pagination cursor; pass unchanged for the next page. Pages slice one snapshot taken on the first call; it expires after ~60s — re-request without a cursor if rejected.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "searchPattern"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "find_files",
      "title": "Find Files",
      "description": "Find files by name or glob pattern, like find. Use when locating files by name or pattern anywhere in the workspace. A pattern without / matches names at any depth (*.ts); a pattern with / matches relative paths (src/**/*.ts). Skips hidden and ignored files by default. Returns matching paths and a nextCursor for paging. Use list to browse directory trees, and search_text to search file contents.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Base directory to search under (default: the only root)",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "pattern": {
            "type": "string",
