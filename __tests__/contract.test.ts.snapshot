exports[`Advertised MCP contract > CONTRACT-001: full server surface matches the snapshot 1`] = `
{
  "capabilities": {
    "completions": {},
    "prompts": {
      "listChanged": true
    },
    "resources": {
      "subscribe": true,
      "listChanged": true
    },
    "tools": {
      "listChanged": true
    }
  },
  "instructions": "Navigation guide for filesystem-mcp tools and constraints. Use list_roots to inspect configured or accepted roots, then list/find_files -> stat -> read. Never guess paths. For full guidance, read internal://instructions or run the get-help prompt.",
  "tools": [
    {
      "name": "create",
      "title": "Create Files",
      "description": "Write whole text files (create new ones, overwrite, or append) or make empty directories. Missing parent directories are created. edit or patch changes part of an existing file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "description": "List of files to create (max 100); each entry requires path and content; combined content is capped at the file-size limit",
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "Absolute path where the file will be created"
                },
                "content": {
                  "type": "string",
                  "description": "Text content to write, verbatim."
                },
                "append": {
                  "description": "Append the content to the end of the file instead of overwriting; creates the file if it does not exist",
                  "type": "boolean"
                },
                "overwrite": {
                  "description": "Replace an existing file without asking the user; without it an existing file prompts for confirmation",
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "directories": {
            "description": "Empty directories to create, like mkdir -p; one that already exists is left as it is",
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "File or directory path inside an allowed workspace root."
            }
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "delete",
      "title": "Delete File",
      "description": "Delete files, directories, or symlinks, like rm or rm -r. Paths are exact; globs are not expanded. Revert with undo.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "paths": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "File or directory path inside an allowed workspace root."
            },
            "description": "Paths to delete (max 1000); accepts files, directories, or symlinks"
          },
          "recursive": {
            "default": false,
            "description": "Delete directory contents recursively (required for non-empty directories)",
            "type": "boolean"
          },
          "ignoreIfNotExists": {
            "default": false,
            "description": "Silently succeed if a path does not exist instead of returning an error",
            "type": "boolean"
          }
        },
        "required": [
          "paths"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "diff",
      "title": "Diff",
      "description": "Compare two text files and return a unified diff from a to b, like diff -u.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "First file to compare"
          },
          "b": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Second file to compare"
          },
          "context": {
            "default": 3,
            "description": "Number of context lines surrounding each change (default: 3)",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 50
          }
        },
        "required": [
          "a",
          "b"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "edit",
      "title": "Edit Files",
      "description": "Edit text files in place by replacing exact oldText with newText, like str_replace. Each oldText must match exactly once, and a file is written only if all its edits match. replace_text replaces every occurrence across files.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Single file path; mutually exclusive with files",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "edits": {
            "description": "Replacements applied to path (required with path); not allowed with files",
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "oldText": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Exact literal text to locate in the file; it must match exactly once. Include 3-5 lines of context so it does — an oldText found in several places fails with their line numbers.",
                  "examples": [
                    "const x = 1;",
                    "function oldName("
                  ]
                },
                "newText": {
                  "type": "string",
                  "description": "Replacement text. Use an empty string to delete the matched oldText.",
                  "examples": [
                    "const x = 2;",
                    "function newName(",
                    ""
                  ]
                }
              },
              "required": [
                "oldText",
                "newText"
              ],
              "additionalProperties": false
            }
          },
          "files": {
            "description": "Per-file entries (batch mode)",
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "File or directory path inside an allowed workspace root."
                },
                "edits": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "oldText": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Exact literal text to locate in the file; it must match exactly once. Include 3-5 lines of context so it does — an oldText found in several places fails with their line numbers.",
                        "examples": [
                          "const x = 1;",
                          "function oldName("
                        ]
                      },
                      "newText": {
                        "type": "string",
                        "description": "Replacement text. Use an empty string to delete the matched oldText.",
                        "examples": [
                          "const x = 2;",
                          "function newName(",
                          ""
                        ]
                      }
                    },
                    "required": [
                      "oldText",
                      "newText"
                    ],
                    "additionalProperties": false
                  },
                  "description": "Replacements to apply to this specific file"
                }
              },
              "required": [
                "path",
                "edits"
              ],
              "additionalProperties": false
            }
          },
          "dryRun": {
            "default": false,
            "description": "Preview diffs without writing to disk (default: false = apply edits)",
            "type": "boolean"
          },
          "ignoreWhitespace": {
            "default": false,
            "description": "Ignore leading/trailing whitespace differences when matching oldText",
            "type": "boolean"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list",
      "title": "List",
      "description": "List a directory's files and subdirectories as a tree of names, like ls or tree. includeSizes adds sizes and a total; stat returns dates.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Directory to list (default: first allowed root)",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxDepth": {
            "default": 1,
            "description": "Max directory depth to traverse (default: 1 = top-level only; increase to recurse deeper)",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 50
          },
          "maxEntries": {
            "default": 1000,
            "description": "Page size (default: 1000). Continue with nextCursor; an incomplete first page also carries resourceUri for the whole list.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 20000
          },
          "includeHidden": {
            "default": false,
            "description": "Include hidden items (starting with .)",
            "type": "boolean"
          },
          "includeIgnored": {
            "default": false,
            "description": "Include ignored items (node_modules, .git, etc).",
            "type": "boolean"
          },
          "includeSizes": {
            "default": false,
            "description": "Show file sizes in the tree and a totals line of counts and bytes",
            "type": "boolean"
          },
          "sortBy": {
            "default": "name",
            "description": "Order within each directory: name (default) or size (largest first)",
            "type": "string",
            "enum": [
              "name",
              "size"
            ]
          },
          "cursor": {
            "description": "Opaque pagination cursor; pass unchanged for the next page. Pages slice one snapshot taken on the first call; it expires after ~60s — re-request without a cursor if rejected.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "move",
      "title": "Move or Copy Files",
      "description": "Move, rename, or copy files and directories, like mv or cp -r. Each destination is the full new path, not a folder to move into; missing parent directories are created.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "moves": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "Path of the file or directory to move or copy"
                },
                "destination": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "Destination path"
                }
              },
              "required": [
                "source",
                "destination"
              ],
              "additionalProperties": false
            },
            "description": "Operations to perform (max 100)"
          },
          "copy": {
            "default": false,
            "description": "Copy instead of move; sources are left in place",
            "type": "boolean"
          },
          "overwrite": {
            "default": false,
            "description": "Copy mode only: overwrite existing destinations without confirmation",
            "type": "boolean"
          }
        },
        "required": [
          "moves"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "patch",
      "title": "Patch",
      "description": "Apply a single-file unified diff to one existing text file, like git apply. Nothing is written unless every hunk applies in file order with exactly matching context; hunks are found by their context, so start line numbers may be off.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "File to apply the diff to"
          },
          "diff": {
            "type": "string",
            "minLength": 1,
            "description": "Single-file unified diff to apply (as produced by the diff tool or edit dry-run)"
          },
          "dryRun": {
            "default": false,
            "description": "Preview the result without writing (default: false)",
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "diff"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "read",
      "title": "Read File",
      "description": "Read text files, like cat: whole, or one slice via head, tail, or startLine/endLine. Images and audio return as media; pass binary: true to get any other binary file whole as a base64 embedded resource.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "includeHash": {
            "default": false,
            "description": "Include SHA-256 hash of the returned content in the response",
            "type": "boolean"
          },
          "binary": {
            "default": false,
            "description": "Return a binary file that is not an image or audio whole, as a base64 embedded resource. Full reads only.",
            "type": "boolean"
          },
          "head": {
            "description": "Return first N lines",
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "tail": {
            "description": "Return last N lines",
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "startLine": {
            "description": "Start line (1-indexed)",
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "endLine": {
            "description": "End line (1-indexed); requires startLine",
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "path": {
            "description": "Single file path; mutually exclusive with paths",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "paths": {
            "description": "Array of file paths for batch mode (max 1000); mutually exclusive with path",
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "File or directory path inside an allowed workspace root."
            }
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "replace_text",
      "title": "Search and Replace",
      "description": "Find and replace every occurrence of literal text or an RE2 regex, like sed -i, in one file or all files under a directory, optionally filtered by glob. The pattern runs over the whole file: it can span lines, and ^ and $ anchor to file start and end. edit replaces one unique exact match.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "File to rewrite, or directory to rewrite under. Omitting it targets the ENTIRE first allowed root — scope it deliberately, and pair a wide scope with dryRun=true first",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "pattern": {
            "description": "Glob to restrict replacements to specific file types (e.g. **/*.ts); default: all text files",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "examples": [
              "**/*.ts",
              "src/**/*.js",
              "**/*.{ts,tsx}"
            ]
          },
          "searchPattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Exact literal text or RE2 regex pattern to search for. When isRegex=true, uses RE2 syntax (no lookahead, lookbehind, or backreferences are supported). Cannot be empty or whitespace-only."
          },
          "replacement": {
            "type": "string",
            "maxLength": 10000,
            "description": "Replacement text. Use capture group references ($1, $2, etc.) when isRegex=true. Use an empty string to delete all matches.",
            "examples": [
              "$1_renamed",
              "",
              "TODO: fix"
            ]
          },
          "isRegex": {
            "default": false,
            "description": "Treat searchPattern as a RE2 regex (default: literal text match)",
            "type": "boolean"
          },
          "includeHidden": {
            "default": false,
            "description": "Include hidden items (starting with .)",
            "type": "boolean"
          },
          "includeIgnored": {
            "default": false,
            "description": "Include ignored items (node_modules, .git, etc).",
            "type": "boolean"
          },
          "caseSensitive": {
            "default": false,
            "description": "Enable case-sensitive matching (default: case-insensitive)",
            "type": "boolean"
          },
          "wholeWord": {
            "default": false,
            "description": "Match whole words only (word boundary anchoring)",
            "type": "boolean"
          },
          "dryRun": {
            "default": false,
            "description": "Preview replacements without writing to disk (default: false = apply changes)",
            "type": "boolean"
          },
          "returnDiff": {
            "default": false,
            "description": "Include a unified diff of all changes in the response",
            "type": "boolean"
          },
          "maxResults": {
            "default": 100,
            "description": "Maximum total match count across all files before stopping",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "maxFiles": {
            "description": "Maximum number of files to process",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "maxDepth": {
            "description": "Max directory depth to scan; 0 = base directory only, omit for unlimited",
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "searchPattern",
          "replacement"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_roots",
      "title": "Workspace Roots",
      "description": "List the directories this server can access, as absolute paths, including any the user granted during this session. Other tools can ask the user to grant access to a path outside them.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "search_text",
      "title": "Search Content",
      "description": "Search file contents for literal text or an RE2 regex, like grep; returns matching lines with line numbers and paths relative to the root, ready to pass to read or edit. Patterns match within one line. find_files matches file names.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "File to search, or directory to search under (default: the whole first allowed root). Naming a file searches that file alone: pattern is ignored and hidden/ignored filtering does not apply.",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "pattern": {
            "description": "Glob to restrict search to specific file types (e.g. **/*.ts); default: all text files",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "examples": [
              "**/*.ts",
              "src/**/*.js",
              "**/*.{ts,tsx}"
            ]
          },
          "searchPattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Exact literal text or RE2 regex pattern to search for in file contents. When isRegex=true, uses RE2 syntax (no lookahead, lookbehind, or backreferences). Cannot be empty or whitespace-only."
          },
          "isRegex": {
            "default": false,
            "description": "Treat searchPattern as a regex (default: literal text match)",
            "type": "boolean"
          },
          "includeHidden": {
            "default": false,
            "description": "Include hidden items (starting with .)",
            "type": "boolean"
          },
          "includeIgnored": {
            "default": false,
            "description": "Include ignored items (node_modules, .git, etc).",
            "type": "boolean"
          },
          "caseSensitive": {
            "default": false,
            "description": "Enable case-sensitive matching (default: case-insensitive)",
            "type": "boolean"
          },
          "maxResults": {
            "default": 500,
            "description": "Maximum number of matching lines to return per page",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "context": {
            "default": 0,
            "description": "Lines of context to return either side of each match, like grep -C (default: 0, max: 10)",
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "maxDepth": {
            "description": "Max directory depth to scan; 0 = base directory only, omit for unlimited",
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "cursor": {
            "description": "Opaque pagination cursor; pass unchanged for the next page. Pages slice one snapshot taken on the first call; it expires after ~60s — re-request without a cursor if rejected.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "searchPattern"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "find_files",
      "title": "Find Files",
      "description": "Find files by name or glob pattern; returns file paths relative to the root, ready to pass to read or edit. A pattern without / matches file names at any depth. search_text searches contents.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Base directory to search under (default: first allowed root)",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Glob pattern to match file paths (e.g. **/*.ts, src/**/*.js)",
            "examples": [
              "**/*.ts",
              "src/**/*.js",
              "**/*.{ts,tsx}"
            ]
          },
          "maxResults": {
            "default": 100,
            "description": "Maximum number of matching files to return per page",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "includeIgnored": {
            "default": false,
            "description": "Include ignored items (node_modules, .git, etc).",
            "type": "boolean"
          },
          "includeHidden": {
            "default": false,
            "description": "Include hidden items (starting with .)",
            "type": "boolean"
          },
          "sortBy": {
            "default": "path",
            "description": "Sort order: path = full path (default), name = basename only",
            "type": "string",
            "enum": [
              "name",
              "path"
            ]
          },
          "maxDepth": {
            "description": "Max directory depth to scan; 0 = base directory only, omit for unlimited",
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "cursor": {
            "description": "Opaque pagination cursor; pass unchanged for the next page. Pages slice one snapshot taken on the first call; it expires after ~60s — re-request without a cursor if rejected.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "pattern"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "stat",
      "title": "Get File Info",
      "description": "Get metadata without reading contents, like ls -ld: type, size (files) or entryCount (directories; secret files not counted), tokenEstimate, timestamps, permissions (readOnly on Windows), MIME type guessed from the extension, and symlink target. Also checks whether paths exist.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Single file path; mutually exclusive with paths",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "paths": {
            "description": "Array of file paths for batch mode (max 1000); mutually exclusive with path",
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "File or directory path inside an allowed workspace root."
            }
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
