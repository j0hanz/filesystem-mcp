            "description": "Revert the last N calls (not over HTTP)",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "dryRun": {
            "default": false,
            "description": "Preview which calls would restore, changing nothing",
            "type": "boolean"
          }
