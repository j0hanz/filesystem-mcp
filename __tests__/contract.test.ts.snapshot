        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "undo",
      "title": "Undo",
      "description": "Revert earlier calls that changed files, by undo id or the last N calls. A file is restored only if unchanged since. dryRun lists the history.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "description": "The undo id from a tool result",
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
