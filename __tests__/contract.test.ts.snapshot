            "description": "Array of file paths for batch mode (max 1000); mutually exclusive with path",
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "File or directory path inside an allowed workspace root."
            }
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "undo",
      "title": "Undo",
      "description": "Revert create, edit, replace_text, patch, move, or delete calls by undo id or the newest N calls. Use when a change made by this server must be reverted. Do not use for outside changes or expired ids; rewrite those with \`edit\` or \`create\`. Preview with dryRun, which lists ids. A path changed since that call is skipped while the rest revert; it stays under its id for a retry. The in-memory journal keeps up to 64 calls for 30 minutes, fewer when FS_MAX_UNDO_BYTES fills. No redo. Unknown ids fail NOT_FOUND. Returns steps[] of {id, tool, results[]}, each path restored or with an error code. A long list is cut (failures kept), marked truncated with totalResults. Errors only if every path fails.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Undo id from a mutating tool result. Required over HTTP, where all clients share the journal.",
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "steps": {
            "description": "Revert the newest N calls, newest first. Not with id; rejected over HTTP. Omit both to revert the newest call.",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "dryRun": {
            "default": false,
            "description": "Preview without changing anything. With no id or steps, previews every journaled call and lists their ids.",
            "type": "boolean"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    }
  ],
  "prompts": [
    {
      "name": "get-help",
      "title": "Get Help",
      "description": "How to use the filesystem-mcp tools and their limits. Call list_roots to see the configured or accepted roots. Find paths with list or find_files, check them with stat, then read. Never guess paths.",
      "arguments": [
        {
          "name": "topic",
          "description": "Section to return (one of: guidelines, tools_overview, constraints, error_recovery). Omit for all instructions.",
          "required": false
        }
      ]
    }
  ],
  "resourceTemplates": [
    {
      "name": "filesystem-mcp-result",
      "title": "Cached Tool Result",
      "uriTemplate": "filesystem-mcp://result/{id}",
      "description": "Cached tool output, listed in resources/list. Entries expire after the cache TTL.",
      "mimeType": "application/json",
      "annotations": {
        "audience": [
          "assistant"
        ],
        "priority": 0.3
      }
    },
    {
      "name": "filesystem-mcp-file",
      "title": "Workspace File",
      "uriTemplate": "filesystem-mcp://file/{+path}",
      "description": "Read a file from the workspace. Subscribe to get updates when the file changes.",
      "annotations": {
        "audience": [
          "assistant"
        ],
        "priority": 0.8
      }
    }
  ],
  "help": {
    "description": "How to use the filesystem-mcp tools and their limits. Call list_roots to see the configured or accepted roots. Find paths with list or find_files, check them with stat, then read. Never guess paths.",
    "messages": [
      {
        "role": "user",
        "content": {
          "type": "text",
          "text": "\\nGuidelines:\\n\`\`\`\\nroot_access: list_roots lists configured or accepted roots; every other tool is scoped to them.\\nmodern_root_grants: Modern clients do not send workspace roots. Call a tool with a concrete path and approve the grant if the client asks (elicitation).\\npath_resolution: Confirm a path with list or find_files before acting on it.\\n\`\`\`\\n\\nTools Overview:\\n\`\`\`\\nNavigate: list_roots, list, find_files\\nInspect: stat, search_text\\nRead: read\\nWrite: create, delete, edit, move, patch, replace_text, undo\\n\`\`\`\\n\\nFull tool schemas are in \`tools/list\`.\\n\\nConstraints:\\n\`\`\`\\nallowed_roots: Startup roots come from CLI paths, FS_ALLOWED_DIRS, or --allow-cwd. Accepted modern grants add to them. Call list_roots to see the current set.\\nlegacy_roots: Legacy clients can also add roots through the deprecated roots/list flow.\\nsensitive_paths: Sensitive files are denied by default: .env, *.pem, SSH private keys (*id_rsa*, *id_ed25519*), .netrc, .git-credentials.\\nenforced_limits: max file size 10 MiB (also the total content cap of one create call), stdio responses up to 9.8 MiB once JSON-encoded (HTTP has no such limit), file search returns up to 10000 results, content search scans up to 10000 matches, paged by maxResults (default 500).\\nephemeral_results: When a result has a resource_link or a resourceUri (in structuredContent or _meta), call resources/read right away. Cached results expire after about 60 seconds, on eviction, or on restart.\\npagination: nextCursor appears in the result text and in _meta, and its snapshot expires on the same ~60s clock. Send the printed Next page call as-is (the original arguments plus cursor). If a cursor is rejected, start again without one. resourceUri appears on the first page only.\\n\`\`\`\\n\\nError Recovery:\\n\`\`\`\\nACCESS_DENIED: Run list_roots. Add the missing startup root, or retry with a concrete path and approve the grant.\\nNOT_FOUND: Run list or find_files to check the path.\\nTOO_LARGE: Over the file size limit, use read with head/tail or startLine/endLine. Over the stdio message limit, ask for a smaller slice or page, or connect over HTTP. Media and binary files need HTTP.\\nTIMEOUT: Narrow the path or pattern, or lower maxDepth. maxResults only sets the page size.\\nINVALID_INPUT: Re-read the tool schema in tools/list.\\nBINARY_FILE: Text tools refuse binary files. read returns the whole file with binary: true.\\n\`\`\`\\n",
          "annotations": {
            "audience": [
              "assistant"
            ],
            "priority": 1
          }
        }
      }
    ]
  }
}
`;

