        "openWorldHint": false
      }
    }
  ],
  "prompts": [
    {
      "name": "get-help",
      "title": "Get Help",
      "description": "Navigation guide for filesystem-mcp tools and constraints. Use list_roots to inspect configured or accepted roots, then list/find_files -> stat -> read. Never guess paths.",
      "arguments": [
        {
          "name": "topic",
          "description": "Section key to filter instructions (one of: guidelines, tools_overview, constraints, error_recovery); omit to return all instructions.",
          "required": false
        }
      ]
    }
  ],
  "resourceTemplates": [
    {
      "name": "filesystem-mcp-result",
      "title": "Cached Tool Result",
      "uriTemplate": "filesystem-mcp://result/{id}",
      "description": "Ephemeral cached tool output. Listed via resources/list; entries expire after the cache TTL.",
      "mimeType": "application/json",
      "annotations": {
        "audience": [
          "assistant"
        ],
        "priority": 0.3
      }
    },
    {
      "name": "filesystem-mcp-file",
      "title": "Workspace File",
      "uriTemplate": "filesystem-mcp://file/{+path}",
      "description": "Read a file from the workspace. Subscribe to get updates when the file changes.",
      "annotations": {
        "audience": [
          "assistant"
        ],
        "priority": 0.8
      }
    }
  ],
  "help": {
    "description": "Navigation guide for filesystem-mcp tools and constraints. Use list_roots to inspect configured or accepted roots, then list/find_files -> stat -> read. Never guess paths.",
    "messages": [
      {
        "role": "user",
        "content": {
          "type": "text",
          "text": "\\nGuidelines:\\n\`\`\`\\nroot_access: list_roots lists configured or accepted roots; every other tool is scoped to them.\\nmodern_root_grants: Modern clients do not automatically send workspace roots. Call a tool with a concrete path and approve its grant when elicitation is available.\\npath_resolution: Confirm a path with list or find_files before acting on it.\\n\`\`\`\\n\\nTools Overview:\\n\`\`\`\\nNavigate: list_roots, list, find_files\\nInspect: stat, search_text\\nRead: read\\nWrite: create, delete, edit, move, patch, replace_text, undo\\n\`\`\`\\n\\nFull schemas, descriptions, and annotations are in \`tools/list\`.\\n\\nConstraints:\\n\`\`\`\\nallowed_roots: Startup roots come from CLI paths, FS_ALLOWED_DIRS, or --allow-cwd; accepted modern grants are additive. Call list_roots to read the current set.\\nlegacy_roots: Legacy clients may additionally seed roots through the deprecated roots/list flow.\\nsensitive_paths: Sensitive file paths (.env, *.pem, SSH private keys such as *id_rsa* and *id_ed25519*, .netrc, .git-credentials) are denied by default.\\nenforced_limits: max file size 10 MB (also the combined content cap of one create call), file search cap 10000 results, content search scans up to 10000 matches, paged by maxResults (default 500).\\nephemeral_results: When a result carries a resource_link or a resourceUri (in structuredContent or _meta), call resources/read immediately — cached results are ephemeral and expire after ~60 seconds, eviction, or restart.\\npagination: nextCursor appears in the result text and in _meta, backed by a snapshot on the same ~60s clock. Send the printed Next page call as-is (the original arguments plus cursor); if a cursor is rejected, start again without one. resourceUri appears on the first page only.\\n\`\`\`\\n\\nError Recovery:\\n\`\`\`\\nACCESS_DENIED: Run list_roots; configure a missing startup root or retry a concrete path and approve the grant.\\nNOT_FOUND: Run list or find_files to verify the path.\\nTOO_LARGE: Use read with head/tail or startLine/endLine, or split across several calls.\\nTIMEOUT: Narrow path or pattern, or lower maxDepth; maxResults only sizes a page.\\nINVALID_INPUT: Re-read the tool schema in tools/list.\\n\`\`\`\\n",
          "annotations": {
            "audience": [
              "assistant"
            ],
            "priority": 1
          }
        }
      }
    ]
  }
}
`;

